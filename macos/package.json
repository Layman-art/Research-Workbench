{
  "name": "research-workbench",
  "private": true,
  "version": "1.0.11",
  "packageManager": "pnpm@11.1.1",
  "type": "module",
  "description": "Local-first macOS workbench for research projects, tasks, schedules, and notes.",
  "author": "Layman-art",
  "license": "MIT",
  "copyright": "Copyright © 2026 Layman-art",
  "homepage": "https://github.com/Layman-art/Research-Workbench#readme",
  "bugs": {
    "url": "https://github.com/Layman-art/Research-Workbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Layman-art/Research-Workbench.git"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "pnpm lint && pnpm test && pnpm build",
    "size": "node scripts/report-bundle-size.mjs",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build --bundles app",
    "dist:mac": "tauri build --bundles app,dmg",
    "dist": "pnpm dist:mac"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/source-serif-4": "^5.1.0",
    "@playwright/test": "^1.54.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "zustand": "^5.0.7"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remove-markdown": "^0.6.4",
    "unified": "^11.0.5"
  }
}
