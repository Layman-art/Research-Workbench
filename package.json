{
  "name": "research-workbench",
  "version": "2.0.0",
  "private": true,
  "description": "Research Workbench — one desktop codebase for Windows and macOS",
  "license": "MIT",
  "workspaces": [
    "desktop"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @research-workbench/desktop",
    "build": "npm run build --workspace @research-workbench/desktop",
    "lint": "npm run lint --workspace @research-workbench/desktop",
    "test": "npm run test --workspace @research-workbench/desktop",
    "test:e2e": "npm run test:e2e --workspace @research-workbench/desktop",
    "check": "npm run check --workspace @research-workbench/desktop",
    "size": "npm run size --workspace @research-workbench/desktop",
    "dev:desktop": "npm run dev:desktop --workspace @research-workbench/desktop",
    "build:desktop": "npm run build:desktop --workspace @research-workbench/desktop",
    "dist:win": "npm run dist:win --workspace @research-workbench/desktop",
    "dist:mac": "npm run dist:mac --workspace @research-workbench/desktop"
  }
}
